# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Twilio (Telephony)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Deepgram (STT — Nova-3)
DEEPGRAM_API_KEY=

# OpenAI (LLM — GPT-4o-mini)
OPENAI_API_KEY=

# Cartesia (TTS — Sonic)
CARTESIA_API_KEY=

# Redis (Distributed Locking)
REDIS_URL=redis://localhost:6379/0

# MCP Server (FastMCP SSE endpoint)
MCP_SERVER_URL=http://localhost:8001/sse

# Frappe CRM (Backend)
FRAPPE_CRM_API_KEY=
FRAPPE_CRM_API_SECRET=
FRAPPE_CRM_URL=https://crm.hvac-business.local
